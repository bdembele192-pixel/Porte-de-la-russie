# Mèche OS — ajouts pour les terminaux interactifs
case $- in *i*) ;; *) return ;; esac
if [ -z "$MECHE_BANNIERE" ]; then
  export MECHE_BANNIERE=1
  printf '\033[1;35mMèche OS\033[0m — tapez \033[1mmarche\033[0m pour les outils de marché '
  printf '(cours, analyse, backtest, risque, actus, alerte, rapport).\n'
fi
alias cours='marche cours'
alias actus='marche actus'
