#!/bin/sh
# Première ouverture de session : affiche la page d'accueil de Mèche OS.
# (Les raccourcis Mèche sont dans le dock en bas de l'écran et dans le menu Applications.)
FLAG="${XDG_CONFIG_HOME:-$HOME/.config}/meche/bienvenue-vue"
[ -f "$FLAG" ] && [ "$1" != "--forcer" ] && exit 0
mkdir -p "$(dirname "$FLAG")"
touch "$FLAG"
sleep 5
exec xdg-open "file:///usr/share/meche/bienvenue.html"
